# Config da API dentro do docker compose — valores SÓ de desenvolvimento local.
ENV=development
DATABASE_URL=postgresql+psycopg://sociman:sociman@postgres:5432/sociman
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="SociMan <nao-responda@sociman.local>"
APP_URL=http://localhost:8180
TEST_DATABASE_URL=postgresql+psycopg://sociman:sociman@postgres:5432/sociman_test
TEST_REDIS_URL=redis://redis:6379/15
# JWT_SECRET: NÃO coloque aqui (arquivo versionado). Em dev a API gera um efêmero;
# para sessões que sobrevivem a restart, defina em apps/api/.env (gitignored).
# MinIO/imgproxy (spec 003) — credenciais SÓ de dev (as mesmas do docker-compose)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sociman
TEST_S3_BUCKET=sociman-test
