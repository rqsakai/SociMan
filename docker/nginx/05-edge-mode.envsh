#!/bin/sh
# Roda antes do envsubst do entrypoint oficial do nginx: define upstream e CSP
# conforme EDGE_MODE.
#   dev  (default) → Vite dev com HMR; CSP de produção + 'unsafe-inline' no
#                    script-src (preamble inline do Vite dev — mesmo caso do vite.config)
#   prod           → build estático servido pelo web-prod; CSP de produção (a mesma
#                    strictCsp de apps/web/vite.config.ts): script-src estrito e
#                    style-src 'self' 'unsafe-inline' (constitution 2.0.0, ADR 0001)
set -e

STRICT_CSP="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"

if [ "$EDGE_MODE" = "prod" ]; then
  export WEB_UPSTREAM="web-prod:80"
  export WEB_CSP="$STRICT_CSP"
else
  export WEB_UPSTREAM="web:5173"
  export WEB_CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
fi

# IP da casa (spec 002-pwa, R8): HTTP por esse host redireciona para HTTPS.
export LAN_HOST="${LAN_HOST:-192.168.86.47}"

echo "[edge] EDGE_MODE=${EDGE_MODE:-dev} → upstream $WEB_UPSTREAM, LAN_HOST=$LAN_HOST"
