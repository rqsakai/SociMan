# "Edge" local — espelha a TOPOLOGIA da Azion (não o runtime): um único domínio
# em :8080 (http) e :8443 (https, cert local), Rules Engine → locations,
# headers de segurança servidos pela borda, rate limit de borda (análogo do
# Edge Firewall) e Image Processor em /img/*.
# ${WEB_UPSTREAM} e ${WEB_CSP} vêm de 05-edge-mode.envsh conforme EDGE_MODE.

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

# Análogo do Edge Firewall: teto de requisições POR IP na borda. É proteção
# volumétrica — o rate limit fino por conta/ação continua no app (regra de
# portabilidade: o app é seguro sozinho).
limit_req_zone $binary_remote_addr zone=edge_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=edge_img:10m rate=30r/s;
# Spec 009 (R7/R9): o MCP dos agentes tem zona própria, por IP. O limite fino é por cliente, na
# API (o edge não conhece o token). O log do /mcp ganha o nome da tool (cabeçalho `Mcp-Name` da
# versão 2026-07-28), nunca o `Authorization`.
limit_req_zone $binary_remote_addr zone=edge_mcp:10m rate=10r/s;
log_format sociman_mcp '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                       '$request_time mcp_name="$http_mcp_name"';

# HTTP pelo IP da casa (${LAN_HOST}) → HTTPS (spec 002-pwa, R8). $host sai sem
# porta. localhost/127.0.0.1 ficam em HTTP (dev e e2e). A CA pública é a única
# exceção (R7): o aparelho precisa baixá-la antes de confiar no HTTPS.
map "$scheme://$host" $http_pelo_ip_da_casa {
  "http://${LAN_HOST}" 1;
  default 0;
}
map "$http_pelo_ip_da_casa$uri" $redirecionar_para_https {
  "1/sociman-ca.crt" 0;
  "1/sociman-ca.cer" 0;
  "~^1/" 1;
  default 0;
}

server {
  listen 8080;
  listen 8443 ssl;
  http2 on;
  server_name _;

  # cert local: mkcert (confiável no browser) ou o autogerado do certgen
  ssl_certificate /etc/nginx/certs/localhost.pem;
  ssl_certificate_key /etc/nginx/certs/localhost-key.pem;

  # DNS do Docker: upstreams em variável resolvem em runtime, então o nginx
  # sobe mesmo se um serviço ainda não estiver de pé
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream "api:3001";
  set $web_upstream "${WEB_UPSTREAM}";
  set $imgproxy_upstream "imgproxy:8080";

  if ($redirecionar_para_https) {
    return 301 https://$host:8543$request_uri;
  }

  # ------------------------------------------------------ CA da casa (R7)
  # Só a parte pública (montada de docker/certs/ca/), .crt em PEM e .cer em DER.
  location ~ ^/sociman-ca\.(crt|cer)$ {
    root /usr/share/nginx/ca;
    types { }
    default_type application/x-x509-ca-cert;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # ------------------------------------------- envio de cortes (spec 004, R4)
  # Só esta rota aceita até 520 MB (a API recusa > 500 MB pelo Content-Length antes de ler o
  # corpo). Sem buffer no edge: o nginx repassa enquanto recebe, sem arquivo temporário aqui.
  location ~ ^/api/perfis/[^/]+/cortes$ {
    client_max_body_size 520m;
    client_body_timeout 120s;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ---------------------------------- envio avulso de vídeo inteiro (spec 006, R16)
  # Até 2 GB (o limite do OpenShorts); a API confere o tamanho. Sem buffer no edge, como os
  # cortes da 004, e timeouts longos para vídeos grandes pela LAN.
  location ~ ^/api/perfis/[^/]+/envios/arquivo$ {
    client_max_body_size 2100m;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------- vídeo próprio da central (spec 014, US5)
  # Até 2 GB, como o envio avulso: a API confere o tamanho e a duração. Sem buffer no edge.
  location ~ ^/api/perfis/[^/]+/conteudos/arquivo$ {
    client_max_body_size 2100m;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------------- tomadas das cenas (spec 010)
  # Até 200 MB (1 a 30 s): a API confere o tamanho e a duração. Sem buffer no edge.
  location ~ ^/api/cenas/[^/]+/tomadas$ {
    client_max_body_size 210m;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------------ mídia assinada (spec 004, R6)
  # Vídeo, fonte e marca d'água por `/api/midia/{token}` (sem login; o token é a
  # autorização). Streaming: sem buffer no edge (o <video> pula com Range e recebe
  # os bytes à medida que a API lê do MinIO).
  location ^~ /api/midia/ {
    limit_req zone=edge_api burst=40 nodelay;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------ envio de fontes (spec 004, R3)
  # A API recusa > 10 MB com `invalid_font`; o edge deixa folga (11m) para o multipart.
  location ~ ^/api/perfis/[^/]+/fontes$ {
    client_max_body_size 11m;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------ arquivos da biblioteca (spec 007, R3)
  # A API recusa > 20 MB com "Arquivo maior que 20 MB"; o edge deixa folga (21m) para o
  # multipart e para a mensagem vir da API, não um 413 daqui. Buffering normal.
  location ~ ^/api/(perfis/[^/]+/assets/arquivo|assets/[^/]+/arquivos)$ {
    client_max_body_size 21m;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # --------------------------------------------------- servidor MCP (spec 009, R9)
  # Streamable HTTP dos agentes. Corpo pequeno, sem buffer (SSE, se o cliente pedir) e a marca
  # interna `X-Sociman-Via` apagada: só a ponte em processo da API pode trazê-la.
  location = /mcp {
    client_max_body_size 1m;
    limit_req zone=edge_mcp burst=20 nodelay;
    proxy_buffering off;
    proxy_read_timeout 120s;
    access_log /var/log/nginx/access.log sociman_mcp;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------------------------------ /api/*
  location /api/ {
    # uploads de imagem (spec 003): a API recusa > 5 MB com mensagem clara; o edge deixa folga (8m) para o multipart e para a API responder
    client_max_body_size 8m;
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Sociman-Via "";   # spec 009 (R9): só a ponte em processo marca a via
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Mirror do edge (fecha o spoof de XFF): o X-Forwarded-For que o cliente
    # mandou é DESCARTADO e reescrito com o IP que o edge enxerga; o app só
    # confia no X-Real-IP daqui (TRUSTED_PROXY=1).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # ------------------------------------------------------------------ /img/*
  # Image Processor (imgproxy) — URLs montadas pelo adapter do app
  # (IMGPROXY_PUBLIC_PATH=/img). O prefixo /img é removido antes do proxy.
  location /img/ {
    limit_req zone=edge_img burst=60 nodelay;
    rewrite ^/img(/.*)$ $1 break;
    proxy_pass http://$imgproxy_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # --------------------------------------------------------------------- /*
  location / {
    proxy_pass http://$web_upstream;
    proxy_http_version 1.1;
    # websocket do HMR do Vite (modo dev)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;

    # Headers que a Azion (Rules Engine) serve em produção — a borda é a ÚNICA
    # dona deles; o que o upstream mandar é descartado (evita duplicatas).
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    add_header Content-Security-Policy "${WEB_CSP}" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  }
}
