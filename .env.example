# Copie para apps/api/.env para rodar a API fora do Docker.
ENV=development
DATABASE_URL=postgresql+psycopg://sociman:sociman@localhost:5432/sociman
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="SociMan <nao-responda@sociman.local>"
APP_URL=http://localhost:8180
TEST_DATABASE_URL=postgresql+psycopg://sociman:sociman@localhost:5432/sociman_test
TEST_REDIS_URL=redis://localhost:6379/15
# JWT_SECRET=<no mínimo 32 caracteres; obrigatório com ENV=production>
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sociman
TEST_S3_BUCKET=sociman-test
# IMGPROXY_KEY/IMGPROXY_SALT (hex): opcionais; defina no .env da raiz para URLs assinadas
# Spec 006: chaves do YouTube Data API e da Anthropic. Ficam SÓ no .env da raiz (gitignored,
# fora do git); o compose as passa para a api e o agendador. Nunca cole o valor aqui.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
# Spec 015 (publicação no TikTok). Os segredos (client secret e a chave dos tokens) ficam SÓ no
# .env da raiz; a chave é gerada pelo dono (quickstart §0.2) e guardada junto do backup.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SOCIMAN_TOKENS_KEY=
SOCIMAN_TOKENS_KEY_ANTERIOR=
# Interruptor do servidor: false = nenhum envio, mesmo com o botão da tela ligado.
PUBLICACAO_HABILITADA=false
TIKTOK_APP_SITUACAO=sandbox
TIKTOK_REDIRECT_WEB=https://192.168.86.47:8543/app/conexoes/retorno
TIKTOK_REDIRECT_DESKTOP=http://localhost:8180/app/conexoes/retorno
# Spec 009 (servidor MCP dos agentes): nível do servidor do interruptor (false = /mcp responde 503 e
# todo token smcp_ é recusado) e origens de navegador aceitas no /mcp, separadas por vírgula (vazio).
MCP_HABILITADO=false
MCP_ORIGENS_PERMITIDAS=

# Spec 013: pastas da agência montadas SÓ LEITURA na API (padrão: ../shared e ../media/clipes).
# AGENCIA_SHARED_HOST=../shared
# AGENCIA_CLIPES_HOST=../media/clipes

# Spec 021 (geração local): token do `dockerctl` (gerado pelo dono com `openssl rand -hex 32`, nunca
# impresso; vazio = o gerador não roda jobs do ComfyUI) e o gid do grupo docker do host
# (`./scripts/data-setup.sh check` mostra). As URLs têm padrão (rede gpu-local).
DOCKERCTL_TOKEN=

# Spec 026 (coleta de mercado, princípio IX): nível do servidor do interruptor (false = a fila
# do coletor vem vazia, mesmo com o botão da tela ligado) e o pepper do hash dos autores de
# avaliação (gerado pelo dono com `openssl rand -hex 32`, nunca impresso; vazio = a ingestão de
# avaliações é recusada).
COLETA_HABILITADA=false
MERCADO_HASH_PEPPER=
# Bases das URLs das tarefas da coleta (rankings, vitrine, categorias, lojas, vídeos): o
# servidor não cita endereços da rede em código (princípio IX); preencha depois da sonda
# com o coletor (quickstart §2). Vazias = só as tarefas de produto nascem.
MERCADO_URL_PUBLICA=
MERCADO_URL_AFFILIATE=
# DOCKER_GID=
# COMFYUI_URL=http://comfyui:8188
# SHOP_TTS_URL=http://shop-tts:8200
